APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hora de Bolivia. En UTC el SIN rechaza por fechaEnvio (codigo 935) y ademas
# el CUF sale mal, porque lleva la fecha de emision adentro.
APP_TIMEZONE=America/La_Paz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siat_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identidad del proveedor ante el SIN (solicitud de autorizacion R-1359).
# Se usan como valor por defecto al dar de alta un cliente.
SIAT_PROVEEDOR_NIT=
SIAT_PROVEEDOR_RAZON_SOCIAL=
SIAT_PROVEEDOR_CODIGO_SISTEMA=
SIAT_PROVEEDOR_NOMBRE_SISTEMA=SolucionDigital-api

# Ambiente por defecto: 1 = Produccion, 2 = Piloto. Cada empresa lleva el suyo.
SIAT_AMBIENTE=2
SIAT_URL_PILOTO=https://pilotosiatservicios.impuestos.gob.bo/v2
SIAT_URL_PRODUCCION=https://siatrest.impuestos.gob.bo/v2

# Firma HMAC-SHA256 de los webhooks. SIN ESTE VALOR LAS NOTIFICACIONES SALEN
# SIN FIRMAR y el cliente no puede comprobar que salieron de aca.
SIAT_WEBHOOK_SECRET=
# Solo en desarrollo: permite apuntar el webhook a localhost / redes privadas.
SIAT_WEBHOOK_PERMITIR_PRIVADOS=false
SIAT_WEBHOOK_TIMEOUT=10

# API REST que consume el sistema de ventas del cliente.
SIAT_RATE_LIMIT=120
SIAT_CACHE_APIKEY_MINUTOS=5

# Transporte SOAP. WSDL_CACHE: 0=none (desarrollo), 1=disco (produccion).
SIAT_TIMEOUT=30
SIAT_CONNECTION_TIMEOUT=15
SIAT_WSDL_CACHE=0
SIAT_TRACE=true

# Dias que se conserva el XML de cada llamada SOAP (incluye datos del comprador).
SIAT_RETENCION_LOGS_DIAS=90
